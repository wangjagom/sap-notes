---
/** 첫 화면: content/site.json의 카드 목록 (tools/index_page.py와 같은 모양) */
import '../styles/fonts.css';
import '../styles/home.css';
import site from '../../content/site.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{site.title}</title>
</head>
<body>
<main>
  <p class="kicker">학습 노트</p>
  <h1>{site.title}</h1>
  <p class="intro">{site.tagline}<br>{site.intro}</p>
  <h2>노트</h2>
  <ul class="cards">
    {site.cards.map((c) => (
      <li><a class="card" href={`${base}${c.slug}/`}><span class="tag">{c.tag}</span><b>{c.title}</b><span class="d">{c.desc}</span></a></li>
    ))}
  </ul>
  {site.links.length > 0 && (
    <>
      <h2>도구</h2>
      <ul class="cards">
        {site.links.map((l) => (
          <li><a class="card" href={l.url} target="_blank" rel="noopener"><b>{l.title} ↗</b><span class="d">{l.desc}</span></a></li>
        ))}
      </ul>
    </>
  )}
  <footer>글은 CC BY-NC-SA 4.0 · 코드는 MIT · 글꼴 Pretendard(OFL)</footer>
</main>
</body>
</html>
